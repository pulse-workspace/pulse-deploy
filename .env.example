# ==============================================================================
# Pulse Platform Environment Configuration
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulsepassword_change_in_production
POSTGRES_PORT=32432

# NATS JetStream Configuration
NATS_PORT=32222
NATS_HTTP_PORT=32822

# RustFS S3 Storage
STORAGE_ACCESS_KEY=pulse
STORAGE_SECRET_KEY=pulsepassword_change_in_production
STORAGE_PORT=32900
STORAGE_CONSOLE_PORT=32901

# Pulse Server Ports
PULSE_WS_PORT=32001
PULSE_ADMIN_PORT=32003
PULSE_API_PORT=32011

# Security & Authentication
PULSE_JWT_SECRET=super-secret-jwt-key-with-at-least-32-characters-required

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=admin
